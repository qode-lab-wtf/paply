<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- User content/settings stay off cloud backups. Device transfer may carry them. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Keystore keys cannot be transferred; never transfer their ciphertext or legacy secrets. -->
        <exclude domain="sharedpref" path="paply-key-vault.xml" />
        <exclude domain="sharedpref" path="paply-private.xml" />
        <exclude domain="file" path="debug-groq-key" />
    </device-transfer>
</data-extraction-rules>
