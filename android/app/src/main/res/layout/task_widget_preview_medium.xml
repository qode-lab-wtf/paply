<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tasks_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/task_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tasks_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Aufgaben" android:textSize="15sp" android:textStyle="bold" android:textColor="#EEF5F0" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tasks_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textSize="22sp" android:textStyle="bold" android:textColor="#3AD879" android:layout_marginStart="4dp" />
    </LinearLayout>
    <TextView android:id="@+id/tasks_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="12dp" android:text="Öffne Paply für deine Aufgaben." android:textSize="13sp" android:textColor="#BFEEC4" />
    <LinearLayout android:id="@+id/tasks_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="visible">
        <TextView android:id="@+id/tasks_check_1" android:layout_width="48dp" android:layout_height="match_parent" android:minHeight="48dp" android:gravity="center" android:text="○" android:textSize="29sp" android:textColor="#D8F39A" android:contentDescription="Aufgabe erledigen" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/tasks_text_1" android:text="Tomaten gießen" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#EEF5F0" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tasks_due_1" android:text="Heute" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#BFEEC4" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
<LinearLayout android:id="@+id/tasks_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="visible">
        <TextView android:id="@+id/tasks_check_2" android:layout_width="48dp" android:layout_height="match_parent" android:minHeight="48dp" android:gravity="center" android:text="○" android:textSize="29sp" android:textColor="#D8F39A" android:contentDescription="Aufgabe erledigen" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/tasks_text_2" android:text="Töpfe besorgen" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#EEF5F0" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tasks_due_2" android:text="Morgen" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#BFEEC4" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
<LinearLayout android:id="@+id/tasks_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="visible">
        <TextView android:id="@+id/tasks_check_3" android:layout_width="48dp" android:layout_height="match_parent" android:minHeight="48dp" android:gravity="center" android:text="○" android:textSize="29sp" android:textColor="#D8F39A" android:contentDescription="Aufgabe erledigen" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/tasks_text_3" android:text="Anleitung testen" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#EEF5F0" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tasks_due_3" android:text="Paply" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#BFEEC4" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
